# ==========================================
# Go Prime Services - Backend Environment Configuration
# ==========================================

# 1. PostgreSQL Database Connection URL
# Replace USER, PASSWORD, HOST, and PORT with your PostgreSQL details.
# Password special chars must be URL-encoded (e.g., @ as %40, # as %23)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/goprimeservices

# 2. Server Port & Permitted Frontend Origins (comma-separated if multiple)
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# 3. Gmail SMTP Configuration
# Use a 16-character Google App Password (not your personal Google account password)
# Generate from: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contactgoprimeservices@gmail.com
SMTP_APP_PASSWORD=YOUR_16_CHARACTER_GOOGLE_APP_PASSWORD

# 4. Email Notification Addresses
MAIL_FROM=Go Prime Services <contactgoprimeservices@gmail.com>
MAIL_TO=contactgoprimeservices@gmail.com
